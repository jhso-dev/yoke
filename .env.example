# yoke configuration. Copy to `.env` (gitignored) and edit.
#
#   cp .env.example .env
#
# Precedence: CLI flag > environment variable > this file > built-in default. A variable already
# present in the environment is NOT overwritten, so a shell export or a CI secret always wins — `.env`
# is a default, never an override.
#
# Read by Node's own parser (`process.loadEnvFile`), at the `yoke` entry point only. Every line here is
# optional: with no `.env` at all, `yoke`, `yoke mcp` and `yoke ui` work against ./yoke.db and never ask
# for a credential.
#
# Two things about the format, both Node's and neither reported as an error:
#   - `#` starts a comment ANYWHERE on the line, so a value containing one must be quoted:
#       YOKE_OPENSEARCH_PASSWORD="p#ssword"   # correct
#       YOKE_OPENSEARCH_PASSWORD=p#ssword     # becomes "p"
#   - a line without `=` is skipped silently.


# ── Storage ────────────────────────────────────────────────────────────────────
# Pick ONE. Nothing set = a local sqlite at ./yoke.db, which is the intended default.

# YOKE_DB=./yoke.db
# YOKE_SHARDS=./shards.json        # federation by namespace; see docs/ENTERPRISE.md

# Remote backends. The knowledge lives there; YOKE_DB still names the LOCAL sqlite holding this
# client's audit trail and API tokens (docs/BACKENDS.md). Setting more than one is an ERROR, not a
# precedence order — they are different knowledge stores.

# YOKE_OPENSEARCH_URL=http://localhost:9200
# YOKE_OPENSEARCH_USER=admin                 # a secured cluster only
# YOKE_OPENSEARCH_PASSWORD=                  # secret
# YOKE_OPENSEARCH_PREFIX=team_a_             # optional: two yoke DBs in one cluster

# YOKE_POSTGRES_URL=postgres://user:pass@localhost:5432/db   # the DSN carries the credentials
# YOKE_POSTGRES_SCHEMA=yoke                  # optional: two yoke DBs in one database


# ── Embeddings ─────────────────────────────────────────────────────────────────
# Unset = no duplicate detection and no `similar`, reported as "skipped" rather than "none found".
# One database has ONE vector space: changing the model needs `yoke backfill --embeddings --rebuild`.

# The URL names the API ROOT — yoke appends /embeddings itself, so …/v1/embeddings here would
# request /v1/embeddings/embeddings and silently break the embedder.
# YOKE_EMBED_URL=http://localhost:11434/v1
# bge-m3 is the recommended local model. nomic-embed-text was suggested before and is
# English-centric — on a corpus with substantial non-English knowledge it makes the vector half of
# retrieval quietly useless (README "Embeddings").
# YOKE_EMBED_MODEL=bge-m3
# YOKE_EMBED_KEY=                            # secret; omit for a keyless local endpoint


# ── Extraction (`yoke connect raw`) ────────────────────────────────────────────
# Unset = the command refuses to run, rather than reading every file and proposing nothing.
# Only this one capture path uses a model; nothing else in yoke calls one.
#
# Same rule as the embed URL: name the API ROOT — yoke appends /chat/completions itself.
# YOKE_LLM_URL=http://localhost:11434/v1
# YOKE_LLM_MODEL=qwen2.5:14b
# YOKE_LLM_KEY=                              # secret; omit for a keyless local endpoint
# YOKE_EXTRACT_CHUNK_CHARS=6000             # source characters per extraction call. A long document
#                                            # in ONE call gets summarised: measured 3 records whole
#                                            # vs 13 in 6k windows, same model and prompt.
# YOKE_EXTRACT_MAX_TOKENS=4000              # ceiling on ONE completion (extraction and relating).
#                                            # A full 7-record answer costs ~2k tokens; this is 2x
#                                            # that, so only a generation that has degenerated into
#                                            # repetition reaches it — uncapped, one such chunk burns
#                                            # the whole timeout on every retry (measured: 161
#                                            # timeouts, 5h24m, over 23 chunks). 0 = this default.
# YOKE_LLM_TIMEOUT_MS=600000                 # 10 min. Node's fetch would give up at 300s, which a
#                                            # local model on a long document exceeds (measured: a 14k
#                                            # -char transcript through a 26B model took 2m31s).


# ── Defaults for every command ─────────────────────────────────────────────────

# YOKE_ACTOR=you@example.com     # who is recorded as the author of a write (default yoke:system)
# YOKE_NS=                       # default namespace (default: the shared one)
# YOKE_SCOPE=                    # default injection/capture scope: a collaboration id


# ── yoke serve only (v3.0) ─────────────────────────────────────────────────────
# `yoke`, `yoke mcp` and `yoke ui` are single-user and ungated by design. These apply to `serve`.

# YOKE_HOST=127.0.0.1            # loopback by default; a public interface needs auth on
# YOKE_AUTH=on                   # multi-tenancy, auth and RBAC
# YOKE_OIDC_ISSUER=              # browser login via an OIDC id_token
# YOKE_OIDC_AUDIENCE=


# ── Deliberately NOT here: the test variables ──────────────────────────────────
# YOKE_TEST_OPENSEARCH_URL / _USER / _PASSWORD
#
# Putting them in `.env` would do nothing — the suite does not read this file — and the reason it does
# not is the point: the suite's setup DELETES the indices it is pointed at (docs/BACKENDS.md). A
# variable you set once and forgot is exactly the thing that must not be able to wipe a database on
# `npm test`. Pass them per run instead:
#
#   YOKE_TEST_OPENSEARCH_URL=http://localhost:9200 npm test

# Extraction retries. A failed call is a chunk nobody read, not a chunk with nothing in it, so one
# dropped call leaves an invisible hole in what gets filed. 0 = fail on the first error.
YOKE_LLM_RETRIES=2
YOKE_LLM_RETRY_BASE_MS=2000
# Chunks of one file extracted at once. Measured 1.6x at 3 against a local endpoint.
YOKE_EXTRACT_CONCURRENCY=4
# After a file's chunks are extracted, offer the ones whose call died once more. The retries above
# cannot cover a burst — every socket in flight dies in the same instant and every backoff runs out
# against the same dead network — and a chunk nobody read leaves no trace in the store. Set to 0 to
# turn it off; that is the control arm, not a saving (it only ever re-offers what failed).
# YOKE_EXTRACT_SWEEP=1
