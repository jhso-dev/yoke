# yoke configuration. Copy to `.env` (gitignored) and edit.
#
#   cp .env.example .env
#
# Precedence: CLI flag > environment variable > this file > built-in default. A variable already
# present in the environment is NOT overwritten, so a shell export or a CI secret always wins — `.env`
# is a default, never an override.
#
# Read by Node's own parser (`process.loadEnvFile`), at the `yoke` entry point only. Every line here is
# optional: with no `.env` at all, `yoke`, `yoke mcp` and `yoke ui` work against ./yoke.db and never ask
# for a credential.
#
# Two things about the format, both Node's and neither reported as an error:
#   - `#` starts a comment ANYWHERE on the line, so a value containing one must be quoted:
#       YOKE_NEO4J_PASSWORD="p#ssword"        # correct
#       YOKE_NEO4J_PASSWORD=p#ssword          # becomes "p"
#   - a line without `=` is skipped silently.


# ── Storage ────────────────────────────────────────────────────────────────────
# Pick ONE. Nothing set = a local sqlite at ./yoke.db, which is the intended default.

# YOKE_DB=./yoke.db
# YOKE_SHARDS=./shards.json        # federation by namespace; see docs/ENTERPRISE.md

# Remote backends. The knowledge lives there; YOKE_DB still names the LOCAL sqlite holding this
# client's audit trail and API tokens (docs/BACKENDS.md). Setting both is an ERROR, not a precedence
# order — they are two different knowledge stores.

# YOKE_NEO4J_URL=bolt://localhost:7687       # or neo4j+s://… for Aura
# YOKE_NEO4J_USER=neo4j
# YOKE_NEO4J_PASSWORD=                       # secret
# YOKE_NEO4J_DATABASE=neo4j                  # optional

# YOKE_OPENSEARCH_URL=http://localhost:9200
# YOKE_OPENSEARCH_USER=admin                 # a secured cluster only
# YOKE_OPENSEARCH_PASSWORD=                  # secret
# YOKE_OPENSEARCH_PREFIX=team_a_             # optional: two yoke DBs in one cluster


# ── Embeddings ─────────────────────────────────────────────────────────────────
# Unset = no duplicate detection and no `similar`, reported as "skipped" rather than "none found".
# One database has ONE vector space: changing the model needs `yoke backfill --embeddings --rebuild`.

# The URL names the API ROOT — yoke appends /embeddings itself, so …/v1/embeddings here would
# request /v1/embeddings/embeddings and silently break the embedder.
# YOKE_EMBED_URL=http://localhost:11434/v1
# bge-m3 is the recommended local model. nomic-embed-text was suggested before and is
# English-centric — on a corpus with substantial non-English knowledge it makes the vector half of
# retrieval quietly useless (README "Embeddings").
# YOKE_EMBED_MODEL=bge-m3
# YOKE_EMBED_KEY=                            # secret; omit for a keyless local endpoint


# ── Defaults for every command ─────────────────────────────────────────────────

# YOKE_ACTOR=you@example.com     # who is recorded as the author of a write (default yoke:system)
# YOKE_NS=                       # default namespace (default: the shared one)
# YOKE_SCOPE=                    # default injection/capture scope: a collaboration id


# ── yoke serve only (v3.0) ─────────────────────────────────────────────────────
# `yoke`, `yoke mcp` and `yoke ui` are single-user and ungated by design. These apply to `serve`.

# YOKE_HOST=127.0.0.1            # loopback by default; a public interface needs auth on
# YOKE_AUTH=on                   # multi-tenancy, auth and RBAC
# YOKE_OIDC_ISSUER=              # browser login via an OIDC id_token
# YOKE_OIDC_AUDIENCE=


# ── Deliberately NOT here: the test variables ──────────────────────────────────
# YOKE_TEST_NEO4J_URL / _USER / _PASSWORD and YOKE_TEST_OPENSEARCH_URL / _USER / _PASSWORD
#
# Putting them in `.env` would do nothing — the suite does not read this file — and the reason it does
# not is the point: the neo4j suite's setup ERASES the database it is pointed at. Once, that was a real
# corpus (docs/BACKENDS.md). A variable you set once and forgot is exactly the thing that must not be
# able to wipe a database on `npm test`. Pass them per run instead:
#
#   YOKE_TEST_NEO4J_URL=bolt://localhost:7687 npm test
