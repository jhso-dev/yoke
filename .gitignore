node_modules/
dist/

# Local configuration. `.env.example` IS committed and lists the variables a person sets;
# a real .env holds backend passwords and the embedder key. `.mcp.json` is the same shape: the
# example is committed, the real one names a database and an embedder endpoint only this machine has.
.env
.env.local
.mcp.json

*.db
*.db-wal
*.db-shm
*.tgz
.DS_Store
yoke-serve.log
yoke-serve.err.log

# Next.js (web/) build output
web/.next/
web/out/
*.tsbuildinfo

# Local git worktrees (EnterWorktree puts them here). A worktree carries its own
# biome.json, which biome rejects as a nested root configuration — so `npm run lint`
# fails for anyone who has one, on a directory that is never part of a commit.
.claude/worktrees/
